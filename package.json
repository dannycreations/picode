  },
  "homepage": "https://github.com/dannycreations/picode",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "24.13.3",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
