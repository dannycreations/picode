{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pi Code",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "build pi-code",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/extension"],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.cjs", "${workspaceFolder}/packages/extension/dist/**/*.js"],
      "env": { "PI_CODE_DEBUG_HTTP": "1" }
    }
  ]
}
