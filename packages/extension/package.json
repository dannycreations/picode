{
  "name": "pi-code",
  "version": "0.0.1",
  "description": "Manage Pi Agent inside Visual Studio Code",
  "displayName": "Pi Code",
  "publisher": "dannycreations",
  "license": "GPL",
  "type": "module",
  "main": "./dist/index.cjs",
  "engines": {
    "node": ">=24.13.3",
    "vscode": ">=1.125.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-code",
          "title": "Pi Code",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "pi-code": [
        {
          "type": "webview",
          "id": "pi-code.chatView",
          "name": "Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "pi-code.generateCommitMessage",
        "title": "Generate Commit Message with Pi",
        "icon": "$(sparkle)"
      },
      {
        "command": "pi-code.addToContext",
        "title": "Add to Context",
        "category": "Pi Code"
      },
      {
        "command": "pi-code.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pi-code.settingsButtonClicked",
          "group": "navigation@10",
          "when": "view == pi-code.chatView"
        }
      ],
      "editor/context": [
        {
          "command": "pi-code.addToContext",
          "when": "editorTextFocus",
          "group": "pi-code@1"
        }
      ],
      "scm/input": [
        {
          "command": "pi-code.generateCommitMessage",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "pi-code.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "vite build && tsx scripts/build.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@pi-code/shared": "workspace:*",
    "es-toolkit": "^1.50.0",
    "ignore": "^7.0.6",
    "shell-quote": "^1.10.0",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@pi-code/webview": "workspace:*",
    "@types/node": "24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
